{
  "name": "media-blender",
  "version": "3.0.0",
  "description": "Easy and predictable media queries",
  "main": "media.scss",
  "scripts": {
    "build": "sass --sourcemap=none test.scss test.css",
    "test": "npm run __stylelint && mocha test/test_sass.js --exit",
    "__stylelint": "stylelint \"*.scss\"",
    "precommit": "npm test",
    "watch": "npm-watch"
  },
  "watch": {
    "test": {
      "patterns": [
        ".",
        "test"
      ],
      "extensions": "js,scss",
      "ignore": "./test.scss"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infinum/media-blender.git"
  },
  "keywords": [
    "scss",
    "mixin",
    "media",
    "mobile",
    "desktop",
    "tablet",
    "blender",
    "retina",
    "orientation",
    "landscape",
    "portrait",
    "css"
  ],
  "author": "Infinum <javascript.team@infinum.co>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/infinum/media-blender/issues"
  },
  "homepage": "https://github.com/infinum/media-blender#readme",
  "devDependencies": {
    "husky": "^0.14.3",
    "mocha": "^11.7.1",
    "mocha-cli": "^1.0.1",
    "npm-watch": "^0.13.0",
    "postcss-scss": "^4.0.9",
    "sass": "^1.89.2",
    "sass-true": "^9.0.0",
    "stylelint": "^16.22.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "stylelint-scss": "^6.12.1"
  }
}
